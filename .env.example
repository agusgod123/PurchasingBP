# =====================================================================
# e-Pengadaan — contoh konfigurasi environment
# Salin menjadi .env (lokal) atau isi di dashboard Vercel/Netlify.
# JANGAN commit file .env yang berisi nilai asli.
# =====================================================================

# --- Database (PostgreSQL / Supabase) --------------------------------
# Lokal:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/purchasing
#   DIRECT_URL=postgresql://postgres:postgres@localhost:5432/purchasing
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL = "Transaction pooler" (port 6543) + ?pgbouncer=true  → dipakai aplikasi
#   DIRECT_URL   = "Session pooler" / direct (port 5432)                → dipakai migrasi
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Opsional: jumlah koneksi per instance (default 3 di Vercel/Netlify, 10 di server sendiri)
# DATABASE_POOL_MAX=3

# --- Aplikasi ---------------------------------------------------------
APP_URL=https://pengadaan.kantor-anda.co.id
APP_NAME=e-Pengadaan
# Zona waktu kantor: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Makassar

# Rahasia acak, minimal 32 karakter. Buat dengan: openssl rand -base64 48
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Dipakai Vercel Cron / scheduler untuk memanggil /api/cron/* (header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=ganti-dengan-string-acak-lain

# --- Penyimpanan dokumen ------------------------------------------------
# supabase = Supabase Storage (wajib di Vercel/Netlify — disk serverless tidak permanen)
# local    = folder di server (Docker/on-premise)
STORAGE_DRIVER=supabase
SUPABASE_URL=https://PROJECTREF.supabase.co
# Service role key: Project Settings → API. RAHASIA — hanya di server, jangan diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Untuk STORAGE_DRIVER=local:
# STORAGE_LOCAL_PATH=/data/storage

# --- Email ------------------------------------------------------------
# smtp = kirim sungguhan, log = hanya dicatat di log server (uji coba), disabled = tidak dikirim
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@kantor-anda.co.id
SMTP_PASSWORD=
SMTP_FROM="e-Pengadaan <no-reply@kantor-anda.co.id>"

# --- Akun admin pertama (dipakai sekali oleh `pnpm db:seed`) -----------
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@kantor-anda.co.id
# ADMIN_PASSWORD=
