// Sistem Pengajuan Barang dan Pelacakan Purchasing
// Skema database (PostgreSQL). Lihat docs/database/erd.md untuk penjelasan tiap tabel.
//
// Konvensi:
// - Nama tabel/kolom snake_case (@@map / @map), model PascalCase.
// - Primary key UUID v7, waktu TIMESTAMPTZ (UTC), uang NUMERIC(18,2), kuantitas NUMERIC(18,3).
// - Transaksi tidak dihapus fisik melalui fitur biasa; gunakan status / penanda.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// ENUM
// =====================================================================

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ScopeAccessLevel {
  READ
  MANAGE
  APPROVE
}

enum ItemType {
  GOODS
  SERVICE
}

enum RequestType {
  GOODS
  SERVICE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  DRAFT
  PENDING_APPROVAL
  REVISION_REQUIRED
  ON_HOLD
  APPROVED
  IN_PROCUREMENT
  READY_FOR_HANDOVER
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLATION_REQUESTED
  CANCELLED
}

enum ApprovalSubjectType {
  REQUEST
  CHANGE_REQUEST
  CANCELLATION
  DISCREPANCY_RESOLUTION
}

enum RoutingMode {
  SEQUENTIAL
  PARALLEL
}

enum StepApprovalMode {
  ALL
  ANY
}

enum ApproverType {
  USER
  ROLE
  REQUESTER_SUPERVISOR
  DEPARTMENT_HEAD
  REQUESTER
}

enum RoleScope {
  ANY_DEPARTMENT
  REQUESTER_DEPARTMENT
}

enum StepCondition {
  ALWAYS
  OVER_BUDGET
}

enum ApprovalInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  ON_HOLD
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  CANCELLED
}

enum AssignmentStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  CANCELLED
  REASSIGNED
  CARRIED_OVER
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_CHANGE_APPROVAL
  READY_TO_ORDER
  ORDERED
  PARTIALLY_RECEIVED
  ON_HOLD
  RECEIVED
  CLOSED
  CANCELLED
}

enum ChangeType {
  PRICE
  QUANTITY
  SPECIFICATION
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FollowupType {
  DELAY
  VENDOR_CONTACT
  ESCALATION
  NOTE
}

enum ItemCondition {
  GOOD
  DAMAGED
  WRONG_ITEM
}

enum DiscrepancyType {
  SHORTAGE
  DAMAGED
  WRONG_ITEM
  OTHER
}

enum DiscrepancyStatus {
  OPEN
  PENDING_APPROVAL
  RESOLVED
}

enum ResolutionType {
  REPLACEMENT
  ACCEPT_SHORTAGE
  RETURN_REFUND
  OTHER
}

enum HandoverStatus {
  PREPARED
  CONFIRMED
  DISPUTED
  CANCELLED
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  REQUEST_ATTACHMENT
  VENDOR_QUOTE
  ORDER_PROOF
  DELIVERY_NOTE
  RECEIPT_EVIDENCE
  DISCREPANCY_EVIDENCE
  HANDOVER_PROOF
  OTHER
}

enum UploadStatus {
  PENDING
  READY
}

enum DocumentStage {
  REQUEST_SUBMIT
  PO_ORDER
  RECEIPT
  HANDOVER_CONFIRM
  PO_CLOSE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum TicketCategory {
  TECHNICAL
  PROCESS
  ACCOUNT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  FORWARDED
  RESOLVED
  CLOSED
}

// =====================================================================
// A. ORGANISASI & AKSES
// =====================================================================

model Department {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(150)
  parentId   String?  @map("parent_department_id") @db.Uuid
  headUserId String?  @map("head_user_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent        Department?           @relation("DepartmentTree", fields: [parentId], references: [id])
  children      Department[]          @relation("DepartmentTree")
  headUser      User?                 @relation("DepartmentHead", fields: [headUserId], references: [id])
  employees     Employee[]
  requests      Request[]
  approvalRules ApprovalRule[]
  scopes        UserDepartmentScope[]
  budgets       DepartmentBudget[]

  @@map("departments")
}

model Employee {
  id               String    @id @default(uuid(7)) @db.Uuid
  employeeNumber   String?   @unique @map("employee_number") @db.VarChar(50)
  fullName         String    @map("full_name") @db.VarChar(200)
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(30)
  departmentId     String    @map("department_id") @db.Uuid
  positionName     String?   @map("position_name") @db.VarChar(150)
  employmentStatus String    @default("ACTIVE") @map("employment_status") @db.VarChar(30)
  supervisorId     String?   @map("supervisor_employee_id") @db.Uuid
  sourceSystem     String?   @map("source_system") @db.VarChar(50)
  sourceEmployeeId String?   @map("source_employee_id") @db.VarChar(100)
  importedAt       DateTime? @map("imported_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  department   Department @relation(fields: [departmentId], references: [id])
  supervisor   Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates Employee[] @relation("EmployeeSupervisor")
  user         User?

  @@unique([sourceSystem, sourceEmployeeId])
  @@index([departmentId])
  @@index([supervisorId])
  @@map("employees")
}

model User {
  id                 String        @id @default(uuid(7)) @db.Uuid
  employeeId         String?       @unique @map("employee_id") @db.Uuid
  username           String        @unique @db.VarChar(50)
  email              String        @unique @db.VarChar(255)
  fullName           String        @map("full_name") @db.VarChar(200)
  passwordHash       String        @map("password_hash")
  accountStatus      AccountStatus @default(PENDING_ACTIVATION) @map("account_status")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  emailVerifiedAt    DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt  DateTime?     @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount   Int           @default(0) @map("failed_login_count")
  lockedUntil        DateTime?     @map("locked_until") @db.Timestamptz(6)
  activatedAt        DateTime?     @map("activated_at") @db.Timestamptz(6)
  disabledAt         DateTime?     @map("disabled_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee? @relation(fields: [employeeId], references: [id])

  roles               UserRole[]            @relation("UserRoleUser")
  rolesAssigned       UserRole[]            @relation("UserRoleAssigner")
  departmentScopes    UserDepartmentScope[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  headOfDepartments   Department[]          @relation("DepartmentHead")

  requests                Request[]                    @relation("RequestRequester")
  requestsCancelled       Request[]                    @relation("RequestCancelledBy")
  requestsPrioritized     Request[]                    @relation("RequestPrioritySetBy")
  requestVersions         RequestVersion[]
  requestStatusChanges    RequestStatusHistory[]
  comments                Comment[]
  approvalRulesCreated    ApprovalRule[]
  approvalRuleSteps       ApprovalRuleStep[]
  approvalAssignments     ApprovalAssignment[]
  approvalDecisions       ApprovalDecision[]
  quotesCreated           VendorQuote[]
  purchaseOrdersOwned     PurchaseOrder[]              @relation("PurchaseOrderOwner")
  purchaseOrdersCancelled PurchaseOrder[]              @relation("PurchaseOrderCancelledBy")
  purchaseOrderLinks      PurchaseOrderRequest[]
  purchaseOrderChanges    PurchaseOrderStatusHistory[]
  followupsResponsible    PurchaseFollowup[]           @relation("FollowupResponsible")
  followupsCreated        PurchaseFollowup[]           @relation("FollowupCreatedBy")
  changeRequestsCreated   ChangeRequest[]
  budgetsCreated          DepartmentBudget[]
  receiptsReceived        GoodsReceipt[]
  discrepanciesReported   ReceiptDiscrepancy[]         @relation("DiscrepancyReportedBy")
  discrepanciesResolved   ReceiptDiscrepancy[]         @relation("DiscrepancyResolvedBy")
  handoversPrepared       Handover[]                   @relation("HandoverPreparedBy")
  handoversConfirmed      Handover[]                   @relation("HandoverConfirmedBy")
  cancellationRequests    CancellationRequest[]        @relation("CancellationRequestedBy")
  cancellationsDecided    CancellationRequest[]        @relation("CancellationDecidedBy")
  documentsUploaded       Document[]                   @relation("DocumentUploadedBy")
  documentsDeleted        Document[]                   @relation("DocumentDeletedBy")
  notifications           Notification[]
  auditLogs               AuditLog[]
  settingsUpdated         SystemSetting[]
  ticketsReported         SupportTicket[]              @relation("TicketReporter")
  ticketsAssigned         SupportTicket[]              @relation("TicketAssignee")
  ticketComments          SupportTicketComment[]

  @@index([accountStatus])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system_role")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]
  ruleSteps   ApprovalRuleStep[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(150)
  module      String  @db.VarChar(50)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserDepartmentScope {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  departmentId String           @map("department_id") @db.Uuid
  accessLevel  ScopeAccessLevel @map("access_level")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId, accessLevel])
  @@map("user_department_scopes")
}

model Session {
  // id = SHA-256 (hex) dari token sesi; token asli hanya ada di cookie pengguna.
  id         String   @id @db.VarChar(64)
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String   @db.VarChar(255)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipAddress, createdAt])
  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// =====================================================================
// B. KATALOG
// =====================================================================

model ItemCategory {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(150)
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  catalogItems CatalogItem[]
  requestItems RequestItem[]

  @@map("item_categories")
}

model CatalogItem {
  id                    String   @id @default(uuid(7)) @db.Uuid
  categoryId            String   @map("category_id") @db.Uuid
  code                  String?  @unique @db.VarChar(100)
  name                  String   @db.VarChar(255)
  description           String?
  itemType              ItemType @default(GOODS) @map("item_type")
  unitName              String   @map("unit_name") @db.VarChar(50)
  defaultEstimatedPrice Decimal? @map("default_estimated_price") @db.Decimal(18, 2)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     ItemCategory         @relation(fields: [categoryId], references: [id])
  requestItems RequestItem[]
  versionItems RequestVersionItem[]

  @@index([categoryId])
  @@index([name])
  @@map("catalog_items")
}

// =====================================================================
// C. PENGAJUAN
// =====================================================================

model Request {
  id                   String        @id @default(uuid(7)) @db.Uuid
  requestNumber        String?       @unique @map("request_number") @db.VarChar(50)
  requesterId          String        @map("requester_id") @db.Uuid
  departmentId         String        @map("department_id") @db.Uuid
  requestType          RequestType   @default(GOODS) @map("request_type")
  title                String        @db.VarChar(255)
  generalReason        String        @map("general_reason")
  requestedPriority    Priority      @default(NORMAL) @map("requested_priority")
  finalPriority        Priority?     @map("final_priority")
  finalPrioritySetById String?       @map("final_priority_set_by") @db.Uuid
  neededDate           DateTime      @map("needed_date") @db.Date
  status               RequestStatus @default(DRAFT)
  currentVersionNumber Int           @default(0) @map("current_version_number")
  estimatedTotal       Decimal       @default(0) @map("estimated_total") @db.Decimal(18, 2)
  holdReason           String?       @map("hold_reason")
  needsReviewAt        DateTime?     @map("needs_review_at") @db.Timestamptz(6)
  lastActivityAt       DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  submittedAt          DateTime?     @map("submitted_at") @db.Timestamptz(6)
  approvedAt           DateTime?     @map("approved_at") @db.Timestamptz(6)
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById        String?       @map("cancelled_by") @db.Uuid
  cancellationReason   String?       @map("cancellation_reason")
  lockVersion          Int           @default(0) @map("lock_version")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester          User       @relation("RequestRequester", fields: [requesterId], references: [id])
  department         Department @relation(fields: [departmentId], references: [id])
  cancelledBy        User?      @relation("RequestCancelledBy", fields: [cancelledById], references: [id])
  finalPrioritySetBy User?      @relation("RequestPrioritySetBy", fields: [finalPrioritySetById], references: [id])

  items                RequestItem[]
  versions             RequestVersion[]
  statusHistory        RequestStatusHistory[]
  comments             Comment[]
  approvalInstances    ApprovalInstance[]
  purchaseOrderLinks   PurchaseOrderRequest[]
  changeRequests       ChangeRequest[]
  handovers            Handover[]
  cancellationRequests CancellationRequest[]
  documents            Document[]
  notifications        Notification[]
  supportTickets       SupportTicket[]

  @@index([status])
  @@index([requesterId])
  @@index([departmentId])
  @@index([submittedAt])
  @@map("requests")
}

model RequestItem {
  id                 String    @id @default(uuid(7)) @db.Uuid
  requestId          String    @map("request_id") @db.Uuid
  lineNo             Int       @map("line_no")
  catalogItemId      String?   @map("catalog_item_id") @db.Uuid
  categoryId         String?   @map("category_id") @db.Uuid
  itemName           String    @map("item_name") @db.VarChar(255)
  specification      String
  quantity           Decimal   @db.Decimal(18, 3)
  // Kuantitas yang ditutup secara resmi (mis. kekurangan diterima / pembatalan sebagian).
  cancelledQuantity  Decimal   @default(0) @map("cancelled_quantity") @db.Decimal(18, 3)
  unitName           String    @map("unit_name") @db.VarChar(50)
  estimatedUnitPrice Decimal   @map("estimated_unit_price") @db.Decimal(18, 2)
  reason             String?
  neededDate         DateTime? @map("needed_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  request            Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  catalogItem        CatalogItem?         @relation(fields: [catalogItemId], references: [id])
  category           ItemCategory?        @relation(fields: [categoryId], references: [id])
  versionItems       RequestVersionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  changeItems        ChangeRequestItem[]
  handoverItems      HandoverItem[]

  @@index([requestId])
  @@index([categoryId])
  @@map("request_items")
}

model RequestVersion {
  id                        String   @id @default(uuid(7)) @db.Uuid
  requestId                 String   @map("request_id") @db.Uuid
  versionNumber             Int      @map("version_number")
  titleSnapshot             String   @map("title_snapshot") @db.VarChar(255)
  generalReasonSnapshot     String   @map("general_reason_snapshot")
  neededDateSnapshot        DateTime @map("needed_date_snapshot") @db.Date
  requestedPrioritySnapshot Priority @map("requested_priority_snapshot")
  estimatedTotalSnapshot    Decimal  @map("estimated_total_snapshot") @db.Decimal(18, 2)
  submittedById             String   @map("submitted_by") @db.Uuid
  submittedAt               DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  changeSummary             String?  @map("change_summary")

  request           Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy       User                 @relation(fields: [submittedById], references: [id])
  items             RequestVersionItem[]
  approvalInstances ApprovalInstance[]

  @@unique([requestId, versionNumber])
  @@map("request_versions")
}

model RequestVersionItem {
  id                         String    @id @default(uuid(7)) @db.Uuid
  requestVersionId           String    @map("request_version_id") @db.Uuid
  sourceRequestItemId        String?   @map("source_request_item_id") @db.Uuid
  catalogItemId              String?   @map("catalog_item_id") @db.Uuid
  categoryIdSnapshot         String?   @map("category_id_snapshot") @db.Uuid
  lineNo                     Int       @map("line_no")
  itemNameSnapshot           String    @map("item_name_snapshot") @db.VarChar(255)
  specificationSnapshot      String    @map("specification_snapshot")
  quantitySnapshot           Decimal   @map("quantity_snapshot") @db.Decimal(18, 3)
  unitNameSnapshot           String    @map("unit_name_snapshot") @db.VarChar(50)
  estimatedUnitPriceSnapshot Decimal   @map("estimated_unit_price_snapshot") @db.Decimal(18, 2)
  reasonSnapshot             String?   @map("reason_snapshot")
  neededDateSnapshot         DateTime? @map("needed_date_snapshot") @db.Date

  version           RequestVersion @relation(fields: [requestVersionId], references: [id], onDelete: Cascade)
  sourceRequestItem RequestItem?   @relation(fields: [sourceRequestItemId], references: [id], onDelete: SetNull)
  catalogItem       CatalogItem?   @relation(fields: [catalogItemId], references: [id])

  @@index([requestVersionId])
  @@map("request_version_items")
}

model RequestStatusHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  fromStatus  RequestStatus? @map("from_status")
  toStatus    RequestStatus  @map("to_status")
  changedById String?        @map("changed_by") @db.Uuid
  reason      String?
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@index([requestId, changedAt])
  @@map("request_status_history")
}

model Comment {
  id              String   @id @default(uuid(7)) @db.Uuid
  requestId       String?  @map("request_id") @db.Uuid
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  body            String
  isInternal      Boolean  @default(false) @map("is_internal")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request       Request?       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id])

  @@index([requestId])
  @@index([purchaseOrderId])
  @@map("comments")
}

// =====================================================================
// D. PERSETUJUAN (mesin generik)
// =====================================================================

model ApprovalRule {
  id             String              @id @default(uuid(7)) @db.Uuid
  code           String              @unique @db.VarChar(100)
  name           String              @db.VarChar(150)
  description    String?
  subjectType    ApprovalSubjectType @default(REQUEST) @map("subject_type")
  requestType    RequestType?        @map("request_type")
  departmentId   String?             @map("department_id") @db.Uuid
  minAmount      Decimal?            @map("min_amount") @db.Decimal(18, 2)
  maxAmount      Decimal?            @map("max_amount") @db.Decimal(18, 2)
  priority       Int                 @default(0)
  routingMode    RoutingMode         @default(SEQUENTIAL) @map("routing_mode")
  isActive       Boolean             @default(true) @map("is_active")
  isSample       Boolean             @default(false) @map("is_sample")
  effectiveFrom  DateTime            @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime?           @map("effective_until") @db.Timestamptz(6)
  createdById    String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department?        @relation(fields: [departmentId], references: [id])
  createdBy  User?              @relation(fields: [createdById], references: [id])
  steps      ApprovalRuleStep[]
  instances  ApprovalInstance[]

  @@index([subjectType, isActive])
  @@map("approval_rules")
}

model ApprovalRuleStep {
  id             String           @id @default(uuid(7)) @db.Uuid
  ruleId         String           @map("approval_rule_id") @db.Uuid
  stepNumber     Int              @map("step_number")
  name           String           @db.VarChar(150)
  approverType   ApproverType     @map("approver_type")
  approverUserId String?          @map("approver_user_id") @db.Uuid
  approverRoleId String?          @map("approver_role_id") @db.Uuid
  roleScope      RoleScope        @default(ANY_DEPARTMENT) @map("role_scope")
  approvalMode   StepApprovalMode @default(ALL) @map("approval_mode")
  condition      StepCondition    @default(ALWAYS)
  isRequired     Boolean          @default(true) @map("is_required")
  dueHours       Int?             @map("due_hours")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  rule         ApprovalRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  approverUser User?          @relation(fields: [approverUserId], references: [id])
  approverRole Role?          @relation(fields: [approverRoleId], references: [id])
  steps        ApprovalStep[]

  @@unique([ruleId, stepNumber])
  @@map("approval_rule_steps")
}

model ApprovalInstance {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  subjectType           ApprovalSubjectType    @map("subject_type")
  requestId             String                 @map("request_id") @db.Uuid
  requestVersionId      String?                @map("request_version_id") @db.Uuid
  changeRequestId       String?                @map("change_request_id") @db.Uuid
  cancellationRequestId String?                @map("cancellation_request_id") @db.Uuid
  discrepancyId         String?                @map("discrepancy_id") @db.Uuid
  ruleId                String?                @map("approval_rule_id") @db.Uuid
  routingMode           RoutingMode            @map("routing_mode")
  status                ApprovalInstanceStatus @default(IN_PROGRESS)
  holdReason            String?                @map("hold_reason")
  startedAt             DateTime               @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime?              @map("completed_at") @db.Timestamptz(6)

  request             Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestVersion      RequestVersion?      @relation(fields: [requestVersionId], references: [id])
  changeRequest       ChangeRequest?       @relation(fields: [changeRequestId], references: [id])
  cancellationRequest CancellationRequest? @relation(fields: [cancellationRequestId], references: [id])
  discrepancy         ReceiptDiscrepancy?  @relation(fields: [discrepancyId], references: [id])
  rule                ApprovalRule?        @relation(fields: [ruleId], references: [id])
  steps               ApprovalStep[]

  @@index([requestId])
  @@index([status])
  @@map("approval_instances")
}

model ApprovalStep {
  id           String             @id @default(uuid(7)) @db.Uuid
  instanceId   String             @map("approval_instance_id") @db.Uuid
  ruleStepId   String?            @map("rule_step_id") @db.Uuid
  stepNumber   Int                @map("step_number")
  name         String             @db.VarChar(150)
  approvalMode StepApprovalMode   @map("approval_mode")
  status       ApprovalStepStatus @default(WAITING)
  startedAt    DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz(6)

  instance    ApprovalInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  ruleStep    ApprovalRuleStep?    @relation(fields: [ruleStepId], references: [id], onDelete: SetNull)
  assignments ApprovalAssignment[]

  @@index([instanceId])
  @@map("approval_steps")
}

model ApprovalAssignment {
  id                    String           @id @default(uuid(7)) @db.Uuid
  stepId                String           @map("approval_step_id") @db.Uuid
  approverUserId        String           @map("approver_user_id") @db.Uuid
  status                AssignmentStatus @default(WAITING) @map("assignment_status")
  note                  String?
  carriedFromDecisionId String?          @map("carried_from_decision_id") @db.Uuid
  reassignedFromId      String?          @map("reassigned_from_id") @db.Uuid
  assignedAt            DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  activatedAt           DateTime?        @map("activated_at") @db.Timestamptz(6)
  dueAt                 DateTime?        @map("due_at") @db.Timestamptz(6)
  lastReminderAt        DateTime?        @map("last_reminder_at") @db.Timestamptz(6)
  reminderCount         Int              @default(0) @map("reminder_count")
  escalatedAt           DateTime?        @map("escalated_at") @db.Timestamptz(6)

  step      ApprovalStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approver  User               @relation(fields: [approverUserId], references: [id])
  decisions ApprovalDecision[]

  @@index([approverUserId, status])
  @@index([stepId])
  @@map("approval_assignments")
}

model ApprovalDecision {
  id           String               @id @default(uuid(7)) @db.Uuid
  assignmentId String               @map("approval_assignment_id") @db.Uuid
  decision     ApprovalDecisionType
  comment      String?
  decidedById  String               @map("decided_by") @db.Uuid
  decidedAt    DateTime             @default(now()) @map("decided_at") @db.Timestamptz(6)

  assignment ApprovalAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  decidedBy  User               @relation(fields: [decidedById], references: [id])

  @@index([assignmentId])
  @@map("approval_decisions")
}

// =====================================================================
// E. VENDOR & PURCHASING
// =====================================================================

model Vendor {
  id            String   @id @default(uuid(7)) @db.Uuid
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(150)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?
  taxNumber     String?  @map("tax_number") @db.VarChar(50)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  quotes         VendorQuote[]

  @@index([name])
  @@map("vendors")
}

model PurchaseOrder {
  id                          String              @id @default(uuid(7)) @db.Uuid
  poNumber                    String              @unique @map("purchase_order_number") @db.VarChar(50)
  vendorId                    String?             @map("vendor_id") @db.Uuid
  purchasingOwnerId           String              @map("purchasing_owner_id") @db.Uuid
  status                      PurchaseOrderStatus @default(DRAFT)
  title                       String?             @db.VarChar(255)
  notes                       String?
  vendorReference             String?             @map("vendor_reference") @db.VarChar(100)
  orderedAt                   DateTime?           @map("ordered_at") @db.Timestamptz(6)
  expectedDeliveryDate        DateTime?           @map("expected_delivery_date") @db.Date
  currentEta                  DateTime?           @map("current_eta") @db.Date
  totalAmount                 Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)
  replacesPurchaseOrderId     String?             @map("replaces_purchase_order_id") @db.Uuid
  replacementForDiscrepancyId String?             @unique @map("replacement_for_discrepancy_id") @db.Uuid
  holdReason                  String?             @map("hold_reason")
  needsReviewAt               DateTime?           @map("needs_review_at") @db.Timestamptz(6)
  lastActivityAt              DateTime            @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  receivedAt                  DateTime?           @map("received_at") @db.Timestamptz(6)
  closedAt                    DateTime?           @map("closed_at") @db.Timestamptz(6)
  cancellationReason          String?             @map("cancellation_reason")
  cancelledById               String?             @map("cancelled_by") @db.Uuid
  cancelledAt                 DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  lockVersion                 Int                 @default(0) @map("lock_version")
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor          Vendor?                      @relation(fields: [vendorId], references: [id])
  purchasingOwner User                         @relation("PurchaseOrderOwner", fields: [purchasingOwnerId], references: [id])
  cancelledBy     User?                        @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id])
  replaces        PurchaseOrder?               @relation("PurchaseOrderReplacement", fields: [replacesPurchaseOrderId], references: [id])
  replacements    PurchaseOrder[]              @relation("PurchaseOrderReplacement")
  replacementFor  ReceiptDiscrepancy?          @relation("DiscrepancyReplacementPo", fields: [replacementForDiscrepancyId], references: [id])
  requestLinks    PurchaseOrderRequest[]
  items           PurchaseOrderItem[]
  quotes          VendorQuote[]
  statusHistory   PurchaseOrderStatusHistory[]
  followups       PurchaseFollowup[]
  changeRequests  ChangeRequest[]
  receipts        GoodsReceipt[]
  discrepancies   ReceiptDiscrepancy[]         @relation("DiscrepancyPurchaseOrder")
  documents       Document[]
  comments        Comment[]
  notifications   Notification[]

  @@index([status])
  @@index([vendorId])
  @@index([purchasingOwnerId])
  @@map("purchase_orders")
}

model PurchaseOrderRequest {
  id              String   @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  linkedAt        DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  linkedById      String   @map("linked_by") @db.Uuid

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  request       Request       @relation(fields: [requestId], references: [id])
  linkedBy      User          @relation(fields: [linkedById], references: [id])

  @@unique([purchaseOrderId, requestId])
  @@index([requestId])
  @@map("purchase_order_requests")
}

// Satu baris PO memenuhi tepat satu item pengajuan. Penggabungan beberapa pengajuan
// terjadi di level PO (purchase_order_requests); satu item pengajuan dapat dipecah ke
// beberapa baris/PO. Model ini menggantikan tabel alokasi terpisah dari ERD v1.
model PurchaseOrderItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  requestItemId   String   @map("request_item_id") @db.Uuid
  lineNo          Int      @map("line_no")
  itemName        String   @map("item_name") @db.VarChar(255)
  specification   String
  unitName        String   @map("unit_name") @db.VarChar(50)
  quantityOrdered Decimal  @map("quantity_ordered") @db.Decimal(18, 3)
  // Kuantitas yang tidak lagi ditunggu (kekurangan diterima, dipindah ke PO pengganti, dibatalkan).
  closedQuantity  Decimal  @default(0) @map("closed_quantity") @db.Decimal(18, 3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  requestItem   RequestItem          @relation(fields: [requestItemId], references: [id])
  receiptItems  GoodsReceiptItem[]
  discrepancies ReceiptDiscrepancy[]
  changeItems   ChangeRequestItem[]

  @@index([purchaseOrderId])
  @@index([requestItemId])
  @@map("purchase_order_items")
}

model VendorQuote {
  id              String    @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String    @map("purchase_order_id") @db.Uuid
  vendorId        String    @map("vendor_id") @db.Uuid
  quoteNumber     String?   @map("quote_number") @db.VarChar(100)
  quoteDate       DateTime  @map("quote_date") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  totalAmount     Decimal   @map("total_amount") @db.Decimal(18, 2)
  currencyCode    String    @default("IDR") @map("currency_code") @db.Char(3)
  isSelected      Boolean   @default(false) @map("is_selected")
  selectionNote   String?   @map("selection_note")
  notes           String?
  createdById     String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  documents     Document[]

  @@index([purchaseOrderId])
  @@map("vendor_quotes")
}

model PurchaseOrderStatusHistory {
  id              String               @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String               @map("purchase_order_id") @db.Uuid
  fromStatus      PurchaseOrderStatus? @map("from_status")
  toStatus        PurchaseOrderStatus  @map("to_status")
  changedById     String?              @map("changed_by") @db.Uuid
  reason          String?
  changedAt       DateTime             @default(now()) @map("changed_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  changedBy     User?         @relation(fields: [changedById], references: [id])

  @@index([purchaseOrderId, changedAt])
  @@map("purchase_order_status_history")
}

model PurchaseFollowup {
  id                   String       @id @default(uuid(7)) @db.Uuid
  purchaseOrderId      String       @map("purchase_order_id") @db.Uuid
  followupType         FollowupType @map("followup_type")
  reason               String?
  previousEta          DateTime?    @map("previous_eta") @db.Date
  newEta               DateTime?    @map("new_eta") @db.Date
  actionTaken          String       @map("action_taken")
  actionDate           DateTime     @map("action_date") @db.Date
  responsibleUserId    String       @map("responsible_user_id") @db.Uuid
  vendorResponse       String?      @map("vendor_response")
  targetResolutionDate DateTime?    @map("target_resolution_date") @db.Date
  createdById          String       @map("created_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  responsibleUser User          @relation("FollowupResponsible", fields: [responsibleUserId], references: [id])
  createdBy       User          @relation("FollowupCreatedBy", fields: [createdById], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_followups")
}

// Perubahan harga/kuantitas/spesifikasi setelah pengajuan disetujui.
// Satu change request per pengajuan, sehingga persetujuan pemohon + atasannya jelas.
model ChangeRequest {
  id              String              @id @default(uuid(7)) @db.Uuid
  requestId       String              @map("request_id") @db.Uuid
  purchaseOrderId String?             @map("purchase_order_id") @db.Uuid
  status          ChangeRequestStatus @default(PENDING)
  reason          String
  createdById     String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt       DateTime?           @map("decided_at") @db.Timestamptz(6)

  request           Request             @relation(fields: [requestId], references: [id])
  purchaseOrder     PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  createdBy         User                @relation(fields: [createdById], references: [id])
  items             ChangeRequestItem[]
  approvalInstances ApprovalInstance[]

  @@index([requestId])
  @@index([purchaseOrderId, status])
  @@map("change_requests")
}

model ChangeRequestItem {
  id                  String     @id @default(uuid(7)) @db.Uuid
  changeRequestId     String     @map("change_request_id") @db.Uuid
  requestItemId       String     @map("request_item_id") @db.Uuid
  purchaseOrderItemId String?    @map("purchase_order_item_id") @db.Uuid
  changeType          ChangeType @map("change_type")
  oldUnitPrice        Decimal?   @map("old_unit_price") @db.Decimal(18, 2)
  newUnitPrice        Decimal?   @map("new_unit_price") @db.Decimal(18, 2)
  oldQuantity         Decimal?   @map("old_quantity") @db.Decimal(18, 3)
  newQuantity         Decimal?   @map("new_quantity") @db.Decimal(18, 3)
  oldSpecification    String?    @map("old_specification")
  newSpecification    String?    @map("new_specification")

  changeRequest     ChangeRequest      @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  requestItem       RequestItem        @relation(fields: [requestItemId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@index([changeRequestId])
  @@index([purchaseOrderItemId])
  @@map("change_request_items")
}

model DepartmentBudget {
  id           String   @id @default(uuid(7)) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  fiscalYear   Int      @map("fiscal_year")
  amount       Decimal  @db.Decimal(18, 2)
  notes        String?
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id])
  createdBy  User?      @relation(fields: [createdById], references: [id])

  @@unique([departmentId, fiscalYear])
  @@map("department_budgets")
}

// =====================================================================
// F. PENERIMAAN & SERAH TERIMA
// =====================================================================

model GoodsReceipt {
  id                 String   @id @default(uuid(7)) @db.Uuid
  receiptNumber      String   @unique @map("receipt_number") @db.VarChar(50)
  purchaseOrderId    String   @map("purchase_order_id") @db.Uuid
  receivedAt         DateTime @map("received_at") @db.Timestamptz(6)
  receivedById       String   @map("received_by") @db.Uuid
  deliveryNoteNumber String?  @map("delivery_note_number") @db.VarChar(100)
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User               @relation(fields: [receivedById], references: [id])
  items         GoodsReceiptItem[]
  documents     Document[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String        @id @default(uuid(7)) @db.Uuid
  receiptId           String        @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String        @map("purchase_order_item_id") @db.Uuid
  quantityReceived    Decimal       @map("quantity_received") @db.Decimal(18, 3)
  quantityAccepted    Decimal       @map("quantity_accepted") @db.Decimal(18, 3)
  quantityRejected    Decimal       @default(0) @map("quantity_rejected") @db.Decimal(18, 3)
  condition           ItemCondition @default(GOOD)
  notes               String?

  receipt           GoodsReceipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id])
  discrepancies     ReceiptDiscrepancy[]

  @@index([receiptId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

model ReceiptDiscrepancy {
  id                  String            @id @default(uuid(7)) @db.Uuid
  purchaseOrderId     String            @map("purchase_order_id") @db.Uuid
  purchaseOrderItemId String            @map("purchase_order_item_id") @db.Uuid
  goodsReceiptItemId  String?           @map("goods_receipt_item_id") @db.Uuid
  type                DiscrepancyType
  quantity            Decimal           @db.Decimal(18, 3)
  description         String
  status              DiscrepancyStatus @default(OPEN)
  resolutionType      ResolutionType?   @map("resolution_type")
  resolutionNote      String?           @map("resolution_note")
  reportedById        String            @map("reported_by") @db.Uuid
  reportedAt          DateTime          @default(now()) @map("reported_at") @db.Timestamptz(6)
  resolvedById        String?           @map("resolved_by") @db.Uuid
  resolvedAt          DateTime?         @map("resolved_at") @db.Timestamptz(6)

  purchaseOrder     PurchaseOrder      @relation("DiscrepancyPurchaseOrder", fields: [purchaseOrderId], references: [id])
  purchaseOrderItem PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id])
  goodsReceiptItem  GoodsReceiptItem?  @relation(fields: [goodsReceiptItemId], references: [id])
  reportedBy        User               @relation("DiscrepancyReportedBy", fields: [reportedById], references: [id])
  resolvedBy        User?              @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id])
  replacementPo     PurchaseOrder?     @relation("DiscrepancyReplacementPo")
  approvalInstances ApprovalInstance[]
  documents         Document[]

  @@index([purchaseOrderId, status])
  @@map("receipt_discrepancies")
}

model Handover {
  id               String         @id @default(uuid(7)) @db.Uuid
  handoverNumber   String         @unique @map("handover_number") @db.VarChar(50)
  requestId        String         @map("request_id") @db.Uuid
  status           HandoverStatus @default(PREPARED)
  location         String?        @db.VarChar(255)
  notes            String?
  preparedById     String         @map("prepared_by") @db.Uuid
  preparedAt       DateTime       @default(now()) @map("prepared_at") @db.Timestamptz(6)
  confirmedById    String?        @map("requester_confirmed_by") @db.Uuid
  confirmedAt      DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  confirmationNote String?        @map("confirmation_note")
  disputeReason    String?        @map("dispute_reason")

  request     Request        @relation(fields: [requestId], references: [id])
  preparedBy  User           @relation("HandoverPreparedBy", fields: [preparedById], references: [id])
  confirmedBy User?          @relation("HandoverConfirmedBy", fields: [confirmedById], references: [id])
  items       HandoverItem[]
  documents   Document[]

  @@index([requestId])
  @@map("handovers")
}

model HandoverItem {
  id                String   @id @default(uuid(7)) @db.Uuid
  handoverId        String   @map("handover_id") @db.Uuid
  requestItemId     String   @map("request_item_id") @db.Uuid
  quantity          Decimal  @db.Decimal(18, 3)
  confirmedQuantity Decimal? @map("confirmed_quantity") @db.Decimal(18, 3)
  notes             String?

  handover    Handover    @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  requestItem RequestItem @relation(fields: [requestItemId], references: [id])

  @@index([handoverId])
  @@index([requestItemId])
  @@map("handover_items")
}

model CancellationRequest {
  id             String             @id @default(uuid(7)) @db.Uuid
  requestId      String             @map("request_id") @db.Uuid
  requestedById  String             @map("requested_by") @db.Uuid
  reason         String
  impactNote     String?            @map("impact_note")
  previousStatus RequestStatus      @map("previous_status")
  status         CancellationStatus @default(PENDING)
  decidedById    String?            @map("decided_by") @db.Uuid
  decisionNote   String?            @map("decision_note")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(6)

  request           Request            @relation(fields: [requestId], references: [id])
  requestedBy       User               @relation("CancellationRequestedBy", fields: [requestedById], references: [id])
  decidedBy         User?              @relation("CancellationDecidedBy", fields: [decidedById], references: [id])
  approvalInstances ApprovalInstance[]

  @@index([requestId])
  @@map("cancellation_requests")
}

// =====================================================================
// G. DOKUMEN
// =====================================================================

// Tepat satu kolom induk yang terisi (CHECK constraint di migrasi).
model Document {
  id               String       @id @default(uuid(7)) @db.Uuid
  storageKey       String       @unique @map("storage_key") @db.VarChar(512)
  originalFilename String       @map("original_filename") @db.VarChar(255)
  mimeType         String       @map("mime_type") @db.VarChar(150)
  sizeBytes        Int          @map("size_bytes")
  sha256           String?      @db.VarChar(64)
  documentType     DocumentType @map("document_type")
  description      String?      @db.VarChar(500)
  uploadStatus     UploadStatus @default(PENDING) @map("upload_status")
  uploadedById     String       @map("uploaded_by") @db.Uuid
  requestId        String?      @map("request_id") @db.Uuid
  vendorQuoteId    String?      @map("vendor_quote_id") @db.Uuid
  purchaseOrderId  String?      @map("purchase_order_id") @db.Uuid
  goodsReceiptId   String?      @map("goods_receipt_id") @db.Uuid
  handoverId       String?      @map("handover_id") @db.Uuid
  discrepancyId    String?      @map("discrepancy_id") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedById      String?      @map("deleted_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedBy    User                @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  deletedBy     User?               @relation("DocumentDeletedBy", fields: [deletedById], references: [id])
  request       Request?            @relation(fields: [requestId], references: [id])
  vendorQuote   VendorQuote?        @relation(fields: [vendorQuoteId], references: [id])
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id])
  handover      Handover?           @relation(fields: [handoverId], references: [id])
  discrepancy   ReceiptDiscrepancy? @relation(fields: [discrepancyId], references: [id])

  @@index([requestId])
  @@index([vendorQuoteId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
  @@index([handoverId])
  @@index([discrepancyId])
  @@map("documents")
}

model DocumentRequirement {
  id           String        @id @default(uuid(7)) @db.Uuid
  stage        DocumentStage
  documentType DocumentType  @map("document_type")
  minCount     Int           @default(1) @map("min_count")
  // Berlaku hanya jika nilai transaksi >= min_amount (opsional), mis. 3 penawaran untuk nilai besar.
  minAmount    Decimal?      @map("min_amount") @db.Decimal(18, 2)
  description  String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([stage, isActive])
  @@map("document_requirements")
}

// =====================================================================
// H. NOTIFIKASI
// =====================================================================

model Notification {
  id              String    @id @default(uuid(7)) @db.Uuid
  recipientId     String    @map("recipient_user_id") @db.Uuid
  type            String    @db.VarChar(60)
  title           String    @db.VarChar(255)
  body            String
  link            String?   @db.VarChar(500)
  requestId       String?   @map("request_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  isMandatory     Boolean   @default(false) @map("is_mandatory")
  dedupeKey       String?   @unique @map("dedupe_key") @db.VarChar(255)
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient     User           @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  request       Request?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  emails        EmailOutbox[]

  @@index([recipientId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model EmailOutbox {
  id             String      @id @default(uuid(7)) @db.Uuid
  notificationId String?     @map("notification_id") @db.Uuid
  toEmail        String      @map("to_email") @db.VarChar(255)
  subject        String      @db.VarChar(255)
  textBody       String      @map("text_body")
  htmlBody       String?     @map("html_body")
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedUntil    DateTime?   @map("locked_until") @db.Timestamptz(6)
  lastError      String?     @map("last_error")
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

// =====================================================================
// I. AUDIT, KONFIGURASI, DUKUNGAN
// =====================================================================

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  reason     String?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

model NumberSequence {
  docType   String @map("doc_type") @db.VarChar(20)
  year      Int
  lastValue Int    @default(0) @map("last_value")

  @@id([docType, year])
  @@map("number_sequences")
}

model IdempotencyKey {
  key        String   @id @db.VarChar(200)
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resultJson Json?    @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("idempotency_keys")
}

model Holiday {
  id   String   @id @default(uuid(7)) @db.Uuid
  date DateTime @unique @db.Date
  name String   @db.VarChar(150)

  @@map("holidays")
}

model SupportTicket {
  id               String         @id @default(uuid(7)) @db.Uuid
  ticketNumber     String         @unique @map("ticket_number") @db.VarChar(50)
  reporterId       String         @map("reporter_id") @db.Uuid
  subject          String         @db.VarChar(255)
  description      String
  category         TicketCategory @default(OTHER)
  urgency          Priority       @default(NORMAL)
  priority         Priority?
  status           TicketStatus   @default(OPEN)
  assigneeId       String?        @map("assignee_id") @db.Uuid
  forwardedTo      String?        @map("forwarded_to") @db.VarChar(255)
  relatedRequestId String?        @map("related_request_id") @db.Uuid
  resolvedAt       DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter       User                   @relation("TicketReporter", fields: [reporterId], references: [id])
  assignee       User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id])
  relatedRequest Request?               @relation(fields: [relatedRequestId], references: [id])
  comments       SupportTicketComment[]

  @@index([status])
  @@index([reporterId])
  @@map("support_tickets")
}

model SupportTicketComment {
  id         String   @id @default(uuid(7)) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("support_ticket_comments")
}

model FaqArticle {
  id          String   @id @default(uuid(7)) @db.Uuid
  category    String   @db.VarChar(100)
  question    String   @db.VarChar(500)
  answer      String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("faq_articles")
}
